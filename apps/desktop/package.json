{
  "name": "aivora-2026.9.19",
  "version": "0.1.0",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k -s first \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:54321 && tsc -p electron/tsconfig.json && cross-env NODE_ENV=development ELECTRON_RENDERER_URL=http://127.0.0.1:54321 electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run build:renderer && npm run build:electron",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "start": "cross-env NODE_ENV=production electron .",
    "test": "vitest run"
  },
  "author": "Aivora Contributors",
  "license": "AGPL-3.0-or-later",
  "description": "An invisible desktop application to help you pass your technical interviews.",
  "dependencies": {
    "@electron/notarize": "^2.3.0",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.2",
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/react-query": "^5.64.0",
    "axios": "^1.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^7.0.0",
    "dotenv": "^16.4.7",
    "electron-log": "^5.2.4",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.9",
    "form-data": "^4.0.1",
    "lucide-react": "^0.460.0",
    "react": "^18.2.0",
    "react-code-blocks": "^0.1.6",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.1",
    "react-syntax-highlighter": "^15.6.1",
    "remark-gfm": "^4.0.1",
    "screenshot-desktop": "^1.15.0",
    "socket.io-client": "^4.7.5",
    "tailwind-merge": "^2.5.5",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^37.2.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^28.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.1",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.aivora.desktop",
    "productName": "Aivora",
    "artifactName": "Aivora-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "config.json",
      "package.json"
    ],
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "liutongzhao",
      "repo": "aivora",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
