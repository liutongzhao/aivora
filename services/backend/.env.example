ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=postgresql+asyncpg://aivora:aivora@127.0.0.1:15439/aivora
REDIS_URL=redis://127.0.0.1:16379/0

MINIO_ENDPOINT=127.0.0.1:19000
MINIO_ACCESS_KEY=aivora
MINIO_SECRET_KEY=change-me
MINIO_SECURE=false
MINIO_BUCKET=aivora-private

AI_BASE_URL=https://ai-pixel.online
AI_MODEL=gpt-6-sol
AI_API_KEY=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIVORA_MASTER_KEY=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

TRIAL_SEARCHES=5
LICENSE_DEFAULT_DURATION_MONTHS=6
LICENSE_MAX_DURATION_MONTHS=24

# QQ mailbox SMTP. Use the QQ mailbox authorization code, not the login password.
MAIL_PROVIDER=smtp
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Aivora
MAIL_USE_TLS=true
MAIL_CODE_TTL_MINUTES=10
MAIL_REGISTRATION_TICKET_TTL_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
WEB_BASE_URL=http://localhost:3000
