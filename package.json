{
  "name": "quizcoze-2026.9.19",
  "version": "2026.9.19",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k -s first \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:54321 && tsc -p electron/tsconfig.json && cross-env NODE_ENV=development ELECTRON_RENDERER_URL=http://127.0.0.1:54321 electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "cross-env NODE_ENV=production electron ."
  },
  "author": "Interview Coder Contributors",
  "license": "AGPL-3.0-or-later",
  "description": "An invisible desktop application to help you pass your technical interviews.",
  "dependencies": {
